# ════════════════════════════════════════════════════════════════
#  APP-LEVEL SECRETS ONLY (Vercel -> Project -> Settings -> Environment Variables).
#  Naam wahi hain jo purane Flask version me the — Next.js migration me kuch rename nahi hua.
#  Kisi individual user ka GitHub token yahan nahi aata: wo OAuth se runtime pe milta hai
#  aur Postgres me encrypted store hota hai.
# ════════════════════════════════════════════════════════════════

# Session cookie sign karne ke liye koi bhi lamba random string (64+ chars).
# NOTE: ab itsdangerous-compatible cookie hi use hoti hai, isliye purani value rakho to users logged-in rahenge.
FLASK_SECRET_KEY=

# Fernet key (32 bytes, url-safe base64, 44 chars, '=' pe end). SAME value rakho jo pehle thi,
# warna Postgres me stored purane encrypted tokens decrypt nahi honge.
FERNET_KEY=

# GitHub OAuth App (github.com/settings/developers). Callback URL: {APP_BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenRouter key (shared AI-fallback; user-specific nahi)
OPENROUTER_KEY=

# Public URL (no trailing slash). Production: https://your-app.vercel.app   Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Neon Postgres connection string (pooled wali better hai), e.g.
# postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Firebase service-account key ka POORA JSON (ek line me paste) — sirf backend chat-sessions ke liye.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional — "development" set karo to cookie Secure flag local HTTP pe relax ho. Production me khaali chhodo.
FLASK_ENV=
